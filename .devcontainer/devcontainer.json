// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go .
{
  "name": "dsa",
  "image": "python:alpine",
  "postCreateCommand": "apk add git",
  // "containerEnv": {
  //   "PATH": "/usr/local/go/bin:${containerEnv:PATH}",
  // },
  "runArgs": ["--add-host=host.docker.internal:host-gateway", "--rm","--name","PodDSA"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "github.copilot.enable": {
          "*": false
        },
        "github.copilot.chat.welcomeMessage": "never"
      }
    }
  },
  "onCreateCommand": "echo OnCreateCmd",
  "remoteUser": "root"
}
